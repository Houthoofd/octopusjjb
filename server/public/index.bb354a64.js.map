            if (response.ok) {
                const result = await response.json();
                console.log(result);
                if (result.message === "L utilisateur peut r\xe9server") return true;
                else {
                    alert("Vous avez d\xe9j\xe0 r\xe9serv\xe9 un cours d'essai.");
                    return false;
